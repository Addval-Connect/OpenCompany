# OpenCompany production overrides for the EC2 host -- template.
#
# This is an OVERRIDE BLOCK, not a whole .env. bootstrap.sh writes
# /opt/opencompany/.env as `.env.template` followed by this file: several
# Settings fields carry no Python default, so a .env holding only these keys
# fails startup with "Field required". The last assignment of a key wins in
# both python-dotenv and pydantic-settings, so everything below overrides the
# template's dev value.
#
# bootstrap.sh substitutes __OC_DOMAIN__, reads __OC_PORT__ out of the shipped
# .env.template (the single place port numbers live), and mints the three
# secrets marked GENERATED with `openssl rand -hex 32`. It never overwrites an
# existing .env: rotating API_KEY_ENCRYPTION_KEY would make every stored
# credential undecryptable.
#
# Read by pydantic-settings as ``../.env`` relative to the uvicorn cwd
# (/opt/opencompany/server), so this file must live at /opt/opencompany/.env.
#
# Only the keys that differ from the .env.template defaults are listed.

# --- network -------------------------------------------------------------
# uvicorn binds loopback only; nginx is the sole public entrypoint.
HOST=127.0.0.1
PYTHON_BACKEND_PORT=__OC_PORT__
PORT=__OC_PORT__
DEBUG=false
WORKERS=1

# --- auth ----------------------------------------------------------------
# The box is internet-facing, so the login gate is mandatory. AUTH_MODE=single
# closes registration after the first user, who becomes the owner.
VITE_AUTH_ENABLED=true
AUTH_MODE=single
# Secure cookie is correct only behind the TLS vhost; certbot must have run.
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=lax
SECRET_KEY=__GENERATED_SECRET_KEY__
JWT_SECRET_KEY=__GENERATED_JWT_SECRET_KEY__
# GENERATED ONCE. Rotating this key orphans every credential in
# credentials.db -- there is no re-encryption path.
API_KEY_ENCRYPTION_KEY=__GENERATED_API_KEY_ENCRYPTION_KEY__

# The SPA is served from the same origin, so this list only needs the
# canonical https origin; a stray http entry would let a downgraded page talk
# to the API.
CORS_ORIGINS=["https://__OC_DOMAIN__"]

# --- execution -----------------------------------------------------------
# Temporal on: durable execution, retries, and deployments that survive a
# restart. The cost is a ~200 MB Go dev server (loopback-bound, SQLite-backed)
# plus nine per-queue in-process workers on top of the backend. bootstrap.sh
# provisions a swapfile (step 2b) as the reserve: unswapped, a transient spike
# on a 2-4 GB instance is not a slowdown, it is the OOM killer choosing a
# victim. `deploy/ec2/temporal.sh off` reverts to the in-process sequential
# executor without a redeploy.
TEMPORAL_ENABLED=true
DEPLOYMENT_MODE=cloud

# DEPLOYMENT_MODE=cloud selects the full-size per-queue worker defaults
# (rest-api=50, triggers-poll/event=100, machina-default=20 ...). Those are
# slot ceilings, not preallocated memory, and ai-heavy + browser -- the two
# queues whose activities are actually heavy -- are resource-tuned against 80%
# host CPU/memory, so the defaults are left alone on a 4 GB box. Drop
# TEMPORAL_AI_HEAVY_CONCURRENCY / TEMPORAL_BROWSER_CONCURRENCY on anything
# smaller.
#
# TEMPORAL_<QUEUE>_CONCURRENCY does NOT belong in this file: worker.py reads
# those from os.environ, and this deployment runs uvicorn directly under
# supervisor, which never exports .env into the process environment the way
# ``company serve`` does. Same trap for every var documented as plugin-owned
# rather than a Settings field. Put such overrides in the supervisor program's
# ``environment=`` line, where they take effect. See deploy/ec2/README.md.

REDIS_ENABLED=false

# --- LLM providers -------------------------------------------------------
# No provider key belongs in this file at all: API keys are entered in the
# Credentials panel and stored encrypted in credentials.db.
#
# AWS_REGION is the one exception in shape, and it does NOT go here either. The
# Bedrock provider needs a region -- its endpoint is regional and a bearer token
# carries none -- but it reads it from os.environ, and supervisor never exports
# .env into the process. An AWS_REGION here would set Settings.aws_region (which
# only the Secrets Manager credential backend reads) and leave the SDK to log
# "No AWS region specified, defaulting to us-east-1". bootstrap.sh writes it into
# the supervisor program's environment= line instead. See deploy/ec2/README.md ->
# AWS Bedrock: the region.

# --- state ---------------------------------------------------------------
# WHERE STATE LIVES. Set on the first install and never changed afterwards:
# bootstrap.sh renders .env once and re-deploys read these two keys rather than
# rewriting them, so a later edit to THIS file does not move a live deployment.
# Moving them on an existing host does not fail -- it silently serves an empty
# deployment while the real workflow.db and credentials.db sit untouched next to
# it. Relocating is a deliberate migration: stop the app, move the tree, edit
# /opt/opencompany/.env, restart.
#
# Substituted by bootstrap.sh with the service account's home + /.opencompany
# (normally /home/oc-app-user/.opencompany), read out of passwd rather than
# assumed. State in that account's own home is deliberate: the account that reads
# and writes it owns the whole path, so nothing here has to grant permissions on a
# directory it does not own -- and it sits outside /opt/opencompany, which puts it
# beyond the reach of the deploy tarball entirely.
#
# Holds workflow.db / credentials.db / workspaces/ / packages/ -- back this
# directory up, nothing else is stateful.
#
# Written absolute rather than as ~/.opencompany on purpose. The app expands ~
# against the running process's HOME, which supervisor sets correctly -- but any
# operator command run without it (root's shell, a cron entry, a forgotten
# `sudo -u oc-app-user`) would expand to a different home and quietly open an
# empty database. An absolute path cannot be misread by anything. bootstrap.sh
# does accept a hand-edited ~/... here and expands it against the service
# account's home.
DATA_DIR=__OC_DATA_DIR__

# Pinned here rather than inherited from .env.template, even though the value is
# the same. Settings.workspace_base_dir resolves relative values under DATA_DIR,
# and .env.template is shipped in the deploy tarball and overwritten on every
# upload -- so left unpinned, the location of every per-workflow file is decided
# by whatever upstream last set that default to. An absolute path here (a
# separate EBS volume, say) is honoured as-is.
WORKSPACE_BASE_DIR=workspaces

# --- logging -------------------------------------------------------------
# Supervisor captures stdout/stderr into /var/log/opencompany/, so no
# LOG_FILE here (that would produce a second, unrotated copy).
LOG_LEVEL=INFO
LOG_FORMAT=text
